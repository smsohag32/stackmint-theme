	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment",
				"comment.block.documentation"
			],
			"settings": {
				"foreground": "#64748b",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords & Storage",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#f472b6",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Functions & Methods",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method",
				"entity.name.method"
			],
			"settings": {
				"foreground": "#2dd4bf"
			}
		},
		{
			"name": "Strings & Characters",
			"scope": [
				"string",
				"punctuation.definition.string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#86efac"
			}
		},
		{
			"name": "Template String Expressions",
			"scope": [
				"punctuation.definition.template-expression",
				"meta.template.expression"
			],
			"settings": {
				"foreground": "#38bdf8"
			}
		},
		{
			"name": "Numbers & Numeric Units",
			"scope": [
				"constant.numeric",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#fb923c"
			}
		},
		{
			"name": "Constants, Booleans, Language Built-ins",
			"scope": [
				"constant.language",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined",
				"variable.language.this",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#fb923c",
				"fontStyle": "bold"
			}
		},
		{
			"name": "User-Defined Constants & UPPERCASE Variables",
			"scope": [
				"variable.other.constant",
				"constant.other"
			],
			"settings": {
				"foreground": "#ff7597"
			}
		},
		{
			"name": "Types, Classes, Interfaces & Enums",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"storage.type.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#facc15"
			}
		},
		{
			"name": "Variables & Identifiers",
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"identifier"
			],
			"settings": {
				"foreground": "#e2e8f0"
			}
		},
		{
			"name": "Function Parameters & Arguments",
			"scope": [
				"variable.parameter",
				"meta.parameter"
			],
			"settings": {
				"foreground": "#fdba74"
			}
		},
		{
			"name": "Object Properties & Keys",
			"scope": [
				"variable.other.property",
				"meta.property-name",
				"support.type.property-name",
				"constant.other.object.key"
			],
			"settings": {
				"foreground": "#38bdf8"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.comparison",
				"keyword.operator.relational",
				"keyword.operator.bitwise",
				"keyword.operator.ternary"
			],
			"settings": {
				"foreground": "#a5b4fc"
			}
		},
		{
			"name": "Punctuation & Delimiters",
			"scope": [
				"punctuation",
				"meta.brace",
				"meta.delimiter",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#94a3b8"
			}
		},
		{
			"name": "HTML & JSX Tags",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"punctuation.definition.tag.begin",
				"punctuation.definition.tag.end"
			],
			"settings": {
				"foreground": "#f472b6"
			}
		},
		{
			"name": "HTML & JSX Attributes",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#fbbf24"
			}
		},
		{
			"name": "React / Component Tags",
			"scope": [
				"support.class.component"
			],
			"settings": {
				"foreground": "#ffd166"
			}
		},
		{
			"name": "CSS Classes & IDs",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#2dd4bf"
			}
		},
		{
			"name": "CSS Properties",
			"scope": [
				"support.type.property-name.css",
				"support.type.property-name.scss"
			],
			"settings": {
				"foreground": "#38bdf8"
			}
		},
		{
			"name": "CSS Values & Pseudo-Selectors",
			"scope": [
				"support.constant.property-value.css",
				"entity.other.attribute-name.pseudo-class.css",
				"entity.other.attribute-name.pseudo-element.css"
			],
			"settings": {
				"foreground": "#fb923c"
			}
		},
		{
			"name": "JSON Keys",
			"scope": [
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#38bdf8"
			}
		},
		{
			"name": "JSON String Values",
			"scope": [
				"string.quoted.double.json"
			],
			"settings": {
				"foreground": "#86efac"
			}
		},
		{
			"name": "Regular Expressions & Escapes",
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#f43f5e"
			}
		},
		{
			"name": "Markdown Headings",
			"scope": [
				"markup.heading",
				"entity.name.section.markdown"
			],
			"settings": {
				"foreground": "#2dd4bf",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#facc15",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#f472b6",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Code",
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#86efac"
			}
		},
		{
			"name": "Markdown Links",
			"scope": [
				"markup.underline.link",
				"string.other.link.title.markdown"
			],
			"settings": {
				"foreground": "#38bdf8",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Invalid & Illegal",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffffff",
				"background": "#ef4444"
			}
		}
	]
}
