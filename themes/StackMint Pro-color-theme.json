	"tokenColors": [
		{
			"name": "Comments & Documentation",
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment",
				"comment.block",
				"comment.block.documentation",
				"comment.line"
			],
			"settings": {
				"foreground": "#546e7a",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Control Flow & Jump Keywords",
			"scope": [
				"keyword.control",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.flow",
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from",
				"keyword.control.trycatch",
				"keyword.control.return"
			],
			"settings": {
				"foreground": "#ff5370",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Storage & Declaration Keywords",
			"scope": [
				"storage.type",
				"storage.modifier",
				"keyword.declaration",
				"storage.type.function",
				"storage.type.class",
				"storage.type.interface",
				"storage.type.enum",
				"storage.type.type"
			],
			"settings": {
				"foreground": "#c792ea",
				"fontStyle": "bold"
			}
		},
		{
			"name": "General Keywords & Operators Words",
			"scope": [
				"keyword",
				"keyword.other",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical",
				"keyword.operator.delete",
				"keyword.operator.typeof",
				"keyword.operator.void",
				"keyword.operator.instanceof"
			],
			"settings": {
				"foreground": "#ff5370"
			}
		},
		{
			"name": "Functions & Methods Call / Declaration",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method",
				"entity.name.method",
				"meta.method-call"
			],
			"settings": {
				"foreground": "#82aaff"
			}
		},
		{
			"name": "Strings & Characters",
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.single",
				"string.quoted.double",
				"string.template"
			],
			"settings": {
				"foreground": "#c3e88d"
			}
		},
		{
			"name": "Template String Expression Delimiters",
			"scope": [
				"punctuation.definition.template-expression.begin",
				"punctuation.definition.template-expression.end",
				"punctuation.definition.template-expression"
			],
			"settings": {
				"foreground": "#ff5370",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Template String Embedded Content",
			"scope": [
				"meta.template.expression"
			],
			"settings": {
				"foreground": "#eeffff"
			}
		},
		{
			"name": "Numbers & Numeric Constants",
			"scope": [
				"constant.numeric",
				"constant.numeric.integer",
				"constant.numeric.float",
				"constant.numeric.hex",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#f78c6c"
			}
		},
		{
			"name": "Booleans & Language Built-ins",
			"scope": [
				"constant.language",
				"constant.language.boolean",
				"constant.language.boolean.true",
				"constant.language.boolean.false",
				"constant.language.null",
				"constant.language.undefined",
				"variable.language.this",
				"variable.language.super",
				"variable.language.self"
			],
			"settings": {
				"foreground": "#ff5370",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Constants & UPPERCASE Identifiers",
			"scope": [
				"variable.other.constant",
				"constant.other",
				"constant.character"
			],
			"settings": {
				"foreground": "#ff869a"
			}
		},
		{
			"name": "Types, Classes, Interfaces & Enums",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class",
				"entity.name.type.interface",
				"entity.name.type.enum",
				"entity.name.type.class"
			],
			"settings": {
				"foreground": "#ffcb6b",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Variables & Identifiers",
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"identifier"
			],
			"settings": {
				"foreground": "#eeffff"
			}
		},
		{
			"name": "Function Parameters & Arguments",
			"scope": [
				"variable.parameter",
				"meta.parameter",
				"variable.parameter.function"
			],
			"settings": {
				"foreground": "#f78c6c"
			}
		},
		{
			"name": "Object Properties & Member Access",
			"scope": [
				"variable.other.property",
				"meta.property-name",
				"support.type.property-name",
				"constant.other.object.key"
			],
			"settings": {
				"foreground": "#80cbc4"
			}
		},
		{
			"name": "Operators",
			"scope": [
				"keyword.operator",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.comparison",
				"keyword.operator.relational",
				"keyword.operator.bitwise",
				"keyword.operator.ternary",
				"keyword.operator.arrow"
			],
			"settings": {
				"foreground": "#89ddff"
			}
		},
		{
			"name": "Delimiters, Braces & Punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"meta.delimiter",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#89ddff"
			}
		},
		{
			"name": "HTML & JSX Element Tags",
			"scope": [
				"entity.name.tag",
				"meta.tag.sgml",
				"punctuation.definition.tag.begin",
				"punctuation.definition.tag.end"
			],
			"settings": {
				"foreground": "#ff5370"
			}
		},
		{
			"name": "HTML & JSX Component Tags",
			"scope": [
				"support.class.component"
			],
			"settings": {
				"foreground": "#ffcb6b",
				"fontStyle": "bold"
			}
		},
		{
			"name": "HTML & JSX Attributes",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#ffcb6b"
			}
		},
		{
			"name": "JSX Expression Containers",
			"scope": [
				"punctuation.section.embedded.begin.jsx",
				"punctuation.section.embedded.end.jsx",
				"punctuation.section.embedded.begin.tsx",
				"punctuation.section.embedded.end.tsx"
			],
			"settings": {
				"foreground": "#80cbc4",
				"fontStyle": "bold"
			}
		},
		{
			"name": "CSS Classes, IDs & Selectors",
			"scope": [
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css",
				"entity.name.tag.css"
			],
			"settings": {
				"foreground": "#00e5a3",
				"fontStyle": "bold"
			}
		},
		{
			"name": "CSS Property Names",
			"scope": [
				"support.type.property-name.css",
				"support.type.property-name.scss",
				"support.type.property-name.less"
			],
			"settings": {
				"foreground": "#80cbc4"
			}
		},
		{
			"name": "CSS Property Values, Units & Functions",
			"scope": [
				"support.constant.property-value.css",
				"keyword.other.unit.css",
				"support.function.misc.css"
			],
			"settings": {
				"foreground": "#f78c6c"
			}
		},
		{
			"name": "CSS Pseudo-Classes & Pseudo-Elements",
			"scope": [
				"entity.other.attribute-name.pseudo-class.css",
				"entity.other.attribute-name.pseudo-element.css"
			],
			"settings": {
				"foreground": "#ff5370"
			}
		},
		{
			"name": "JSON Property Keys",
			"scope": [
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#80cbc4"
			}
		},
		{
			"name": "JSON String Values",
			"scope": [
				"string.quoted.double.json"
			],
			"settings": {
				"foreground": "#c3e88d"
			}
		},
		{
			"name": "JSON Numbers & Constants",
			"scope": [
				"constant.numeric.json",
				"constant.language.json"
			],
			"settings": {
				"foreground": "#f78c6c"
			}
		},
		{
			"name": "YAML Keys",
			"scope": [
				"entity.name.tag.yaml"
			],
			"settings": {
				"foreground": "#80cbc4"
			}
		},
		{
			"name": "Regular Expressions & Escaped Characters",
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#ff5370"
			}
		},
		{
			"name": "Markdown Headings",
