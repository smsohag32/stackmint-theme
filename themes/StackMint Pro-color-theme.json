				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Links & URLs",
			"scope": [
				"markup.underline.link",
				"string.other.link.title.markdown",
				"string.other.link.description.markdown"
			],
			"settings": {
				"foreground": "#82aaff",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markdown Lists & Checkboxes",
			"scope": [
				"punctuation.definition.list.begin.markdown",
				"markup.list"
			],
			"settings": {
				"foreground": "#00e5a3"
			}
		},
		{
			"name": "Markdown Tables",
			"scope": [
				"markup.table"
			],
			"settings": {
				"foreground": "#eeffff"
			}
		},
		{
			"name": "Invalid & Errors",
