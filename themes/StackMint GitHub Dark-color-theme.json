				"markup.heading",
				"entity.name.section.markdown",
				"punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#58a6ff",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Bold",
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#f2cc60",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Italic",
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#ff7b72",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Fenced & Inline Code Blocks",
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code",
				"markup.fenced_code.block"
			],
			"settings": {
				"foreground": "#7ee787"
			}
		},
		{
			"name": "Markdown Code Block Fences (```)",
			"scope": [
				"punctuation.definition.markdown"
			],
			"settings": {
