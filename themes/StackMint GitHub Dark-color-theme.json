			"scope": [
				"markup.underline.link",
				"string.other.link.title.markdown",
				"string.other.link.description.markdown"
			],
			"settings": {
				"foreground": "#58a6ff",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markdown Lists & Checkboxes",
			"scope": [
				"punctuation.definition.list.begin.markdown",
				"markup.list"
			],
			"settings": {
				"foreground": "#3fb950"
			}
		},
		{
			"name": "Markdown Tables",
			"scope": [
				"markup.table"
